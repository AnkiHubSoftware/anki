# Dev environment — loaded automatically by justfile (set dotenv-load)
# Also inherited by subprocesses (e.g. pytest, conftest Anki launcher)

# Qt WebEngine remote debugging (Chrome DevTools Protocol on port 8080)
QTWEBENGINE_REMOTE_DEBUGGING=8080
QTWEBENGINE_CHROMIUM_FLAGS=--remote-allow-origins=http://localhost:8080

# Anki dev mode
ANKIDEV=1
PYTHONWARNINGS=default
PYTHONPYCACHEPREFIX=out/pycache
RUST_BACKTRACE=1

# Anki HTTP API
ANKI_API_PORT=40000
ANKI_API_HOST=127.0.0.1

# Integration tests: Anki instance launched by pytest uses this port
# (separate from the dev instance on 8080 so they don't clash)
ANKI_TEST_PORT=8081
